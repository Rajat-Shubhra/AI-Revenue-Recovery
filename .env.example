# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── AI provider ──────────────────────────────────────────────────────────
# Which provider the diagnose step uses: "groq" or "gemini".
# Only the one you select needs a key.
LLM_PROVIDER=groq

# Groq — the default. Free tier is 14,400 requests/day at 30/min, no card.
# Key: https://console.groq.com
# Note: Groq enforces limits per organisation, so a second key does not help.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — kept wired as a cross-check that results are not specific to one
# model. Free tier is 20 requests/day at 5/min, which is tight for a batch.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash
